# Базовый URL API — теперь напрямую на backend порт 8080
VITE_API_BASE_URL=http://127.0.0.1:8080/api/v1

# Прокси бэкенда в dev (остается на случай локальной разработки)
VITE_DEV_API_PROXY=http://127.0.0.1:8080

# Xsolla Login (OAuth2 implicit / redirect)
VITE_XSOLLA_LOGIN_CLIENT_ID=309556c8-b8b4-4b82-9c10-6b111687e4e3
# Должен совпадать с redirect URI в настройках Xsolla Login
VITE_XSOLLA_LOGIN_REDIRECT_URI=http://localhost:8080/

# Xsolla Store — ID проекта для Catalog API (virtual items)
VITE_XSOLLA_PROJECT_ID=304394

# База URL каталога: в dev — прокси /xsolla-catalog; в проде задайте полный URL своего прокси
VITE_XSOLLA_CATALOG_BASE_URL=/xsolla-catalog
